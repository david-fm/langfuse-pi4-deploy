# Langfuse v4 environment variables for Dokploy on Pi4.
# Copy to .env and fill in the required values.

# Required: generate via `openssl rand -hex 32`
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# ClickHouse (defaults work for local setup)
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DB=default

# Postgres (defaults work for local setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Redis
REDIS_PASSWORD=redispassword

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# Langfuse init (auto-creates project on first boot)
LANGFUSE_INIT_ORG_ID=malaria-sentinel
LANGFUSE_INIT_PROJECT_ID=janus
LANGFUSE_INIT_PROJECT_NAME=Janus
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_USER_NAME=Janus Admin
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=

# Public URL
NEXTAUTH_URL=https://langfuse.davidfm.dev
